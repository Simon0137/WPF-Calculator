<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="PF Calculator" Height="380" Width="345" ResizeMode="CanMinimize">
    <Window.Background>
        <ImageBrush ImageSource="/photo_2026-09-13_21-49-06.jpg"/>
    </Window.Background>
    <Grid>
        <Label x:Name="CurrentAgeLabel" Content="Введите свой текущий возраст: " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="216"/>
        <Label x:Name="CurrentAgeErrorLabel" Content="Current Age Error" HorizontalAlignment="Left" Margin="10,28,0,0" VerticalAlignment="Top" FontSize="6" Width="216"/>
        <TextBox x:Name="CurrentAgeBox" HorizontalAlignment="Left" Margin="226,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="85" LostFocus="CurrentAgeBox_LostFocus" PreviewTextInput="CurrentAgeBox_PreviewTextInput" GotFocus="CurrentAgeBox_GotFocus" TextChanged="CurrentAgeBox_TextChanged"/>
        <Label x:Name="TargetAgeLabel" Content="Введите свой целевой возраст: " HorizontalAlignment="Left" Margin="10,46,0,0" VerticalAlignment="Top" Width="216"/>
        <Label x:Name="TargetAgeErrorLabel" Content="Target Age Error" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top" FontSize="6" Width="216"/>
        <Label

    Width="216" VerticalAlignment="Top" x:Name="StartCapitalLabel" Margin="10,82,0,0" HorizontalAlignment="Left" Content="Введите свои текущие сбережения: "/>
        <TextBox x:Name="StartCapitalBox"

    Width="85" VerticalAlignment="Top" TextWrapping="Wrap" Margin="226,86,0,0" HorizontalAlignment="Left" LostFocus="StartCapitalBox_LostFocus" GotFocus="StartCapitalBox_GotFocus" PreviewTextInput="StartCapitalBox_PreviewTextInput" TextChanged="StartCapitalBox_TextChanged"/>
        <Label

            Width="216" VerticalAlignment="Top" x:Name="MonthlyPayLabel" Margin="10,119,0,0" HorizontalAlignment="Left" Content="Введите ежемесячный взнос: "/>
        <TextBox x:Name="MonthlyPayBox"

            Width="85" VerticalAlignment="Top" TextWrapping="Wrap" Margin="226,123,0,0" HorizontalAlignment="Left" LostFocus="MonthlyPayBox_LostFocus" GotFocus="MonthlyPayBox_GotFocus" PreviewTextInput="MonthlyPayBox_PreviewTextInput" TextChanged="MonthlyPayBox_TextChanged"/>
        <Label

            Width="216" VerticalAlignment="Top" x:Name="MonthlyPayErrorLabel" Margin="10,141,0,0" HorizontalAlignment="Left" FontSize="6" Content="Monthly Pay Error"/>
        <Label

            Width="216" VerticalAlignment="Top" x:Name="YearProfitLabel" Margin="10,155,0,0" HorizontalAlignment="Left" Content="Введите ожидаемый % год. доход-ти: "/>
        <Label

            Width="216" VerticalAlignment="Top" x:Name="YearProfitErrorLabel" Margin="10,176,0,0" HorizontalAlignment="Left" FontSize="6" Content="Year Profit Error"/>
        <TextBox x:Name="YearProfitBox"

            Width="85" VerticalAlignment="Top" TextWrapping="Wrap" Margin="226,159,0,0" HorizontalAlignment="Left" LostFocus="YearProfitBox_LostFocus" GotFocus="YearProfitBox_GotFocus" PreviewTextInput="YearProfitBox_PreviewTextInput" TextChanged="YearProfitBox_TextChanged"/>
        <Button Content="Рассчитать" HorizontalAlignment="Center" Height="19" Margin="0,199,0,0" VerticalAlignment="Top" Width="92" Click="Button_Click"/>
        <TextBox x:Name="TargetAgeBox"

    Width="85" VerticalAlignment="Top" TextWrapping="Wrap" Margin="226,50,0,0" HorizontalAlignment="Left" LostFocus="TargetAgeBox_LostFocus" PreviewTextInput="TargetAgeBox_PreviewTextInput" GotFocus="TargetAgeBox_GotFocus" TextChanged="TargetAgeBox_TextChanged"/>
        <Label x:Name="StartCapitalErrorLabel" Content="Start Capital Error" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top" FontSize="6" Width="216"/>
        <Label x:Name="ResultAgeLabel" Content="Лет до пенсии:" HorizontalAlignment="Left" Margin="10,228,0,0" VerticalAlignment="Top" Height="26"/>
        <Label x:Name="OwnAmountLabel" Content="Вы внесете всего:" HorizontalAlignment="Left" Margin="10,254,0,0" VerticalAlignment="Top"/>
        <Label x:Name="InvestmentsLabel" Content="Доход от инвестиций:" HorizontalAlignment="Left" Margin="10,280,0,0" VerticalAlignment="Top"/>
        <Label x:Name="TotalCapitalLabel" Content="Итоговый капитал:" HorizontalAlignment="Left" Margin="10,306,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="ResultAgeBlock" HorizontalAlignment="Left" Margin="107,233,0,0" TextWrapping="Wrap" Text="Result Age" VerticalAlignment="Top"/>
        <TextBlock x:Name="OwnAmountBlock" HorizontalAlignment="Left" Margin="122,259,0,0" TextWrapping="Wrap" Text="Own Amount" VerticalAlignment="Top"/>
        <TextBlock x:Name="InvestmentsBlock" HorizontalAlignment="Left" Margin="146,285,0,0" TextWrapping="Wrap" Text="Investments" VerticalAlignment="Top"/>
        <TextBlock x:Name="TotalCapitalBlock" HorizontalAlignment="Left" Margin="129,311,0,0" TextWrapping="Wrap" Text="Total Capital" VerticalAlignment="Top"/>

    </Grid>
</Window>
